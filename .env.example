# -------------------------
# Frontend (React + Vite)
# -------------------------
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-anon-key
# Local frontend development only. In Vercel, set this to your HTTPS Render URL
# (for example, https://your-service.onrender.com) in Project Settings.
VITE_API_BASE_URL=http://localhost:8000

# -------------------------
# Backend (Django)
# -------------------------
DEBUG=false
SECRET_KEY=generate-a-new-long-random-secret-for-production
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app
SITE_URL=https://api.example.com
# Render: pin the Python runtime used by this project.
PYTHON_VERSION=3.13.5
# Supabase Postgres values from the Supabase Connect dialog. Do not use SQLite on Render.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-database-password
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMISSION_SUPPORT_EMAIL=admissions@example.com
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15555550123
SUPABASE_BACKUP_BUCKET=branch-backups
# Production backups require SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above.
# Local disk fallback is allowed only with DEBUG=true outside Render.
USE_SUPABASE_REPORTS=false
# This flag chooses the history/snapshot database, not ZIP storage. Keep the
# current value when fixing an existing deployment; see docs/BACKUP_DEPLOYMENT.md.
USE_SUPABASE_BACKUPS=false
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
BACKUP_DISPATCH_INTERVAL_SECONDS=60

# -------------------------
# Authentication (Optional)
# -------------------------
AUTH_SECRET=your-jwt-secret
